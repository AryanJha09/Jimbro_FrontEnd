# JimBro Flutter client environment
#
# This file documents only client-safe values. Flutter bundles `.env` as an
# app asset, so do not place service-role keys, database URLs, JWT secrets, or
# private provider API keys here.

# mock keeps the app fully local. fastapi enables the live backend.
APP_BACKEND_MODE=mock

# fastapi uses the app/backend auth flow. supabase uses Supabase client auth.
AUTH_MODE=fastapi

# Required for APP_BACKEND_MODE=fastapi. Must include /api/v1.
FASTAPI_BASE_URL=https://your-fastapi-host.example.com/api/v1

# Required for AUTH_MODE=supabase. These are public Supabase client values.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Optional deep-link callback values.
SUPABASE_REDIRECT_SCHEME=jimbro
SUPABASE_REDIRECT_HOST=login-callback
